type query { 
  allFilms(before: "2000", after: "1976") {
    edges {
      node {
        id
      }
    }
  }
  character(id: "1000") {
    name
    height
    gender
    habitat
  }
}code

query ExplorePlanets {
  allPlanets(first: 5) {
    planets {
      name
    }
  }
}

query StarshipsInformation {
  allStarships(first: 3) {
    starships {
      name
      model
    }
  }
}
